PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-quiz-generator
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHATBOT_API_KEY=your_chatbot_gemini_api_key_here
GEMINI_CHATBOT_MODEL=gemini-2.5-flash
GEMINI_FEEDBACK_API_KEY=your_feedback_api_key_here
GEMINI_FEEDBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# JWT and email configuration
JWT_SECRET=your_jwt_secret_key_here

# Email / OTP delivery using Nodemailer
# For Gmail: smtp.gmail.com, port 465, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_google_app_password
FROM_EMAIL="AI Quiz Generator <your-email@gmail.com>"
