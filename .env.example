PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-quiz-generator
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email / OTP delivery. For Gmail use smtp.gmail.com, port 465, and a
# 16-character Google App Password (not your usual Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_google_app_password
FROM_EMAIL="AI Quiz Generator <your-email@gmail.com>"
